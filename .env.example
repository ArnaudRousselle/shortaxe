# Copier ce fichier en .env.local et remplir avec les valeurs de ton projet Supabase
# (Supabase → Project Settings → API Keys / Data API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique : "publishable key" (sb_publishable_...) ou ancienne "anon key". Jamais la clé secrète / service_role.
VITE_SUPABASE_ANON_KEY=
